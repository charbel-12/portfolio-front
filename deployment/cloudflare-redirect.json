{
  "description": "Redirect www to canonical apex, preserving path and query",
  "expression": "(http.host eq \"www.charbelmdawar.com\")",
  "action": "redirect",
  "action_parameters": {
    "from_value": {
      "status_code": 301,
      "target_url": { "expression": "concat(\"https://charbelmdawar.com\", http.request.uri.path)" },
      "preserve_query_string": true
    }
  },
  "enabled": true
}
